{
  "name": "react-native-keyboard-shortcuts",
  "version": "1.0.0",
  "description": "custom keyboard shortcut module for React Native(desktop)",
  "main": "./src/index.ts",
  "files": [
    "src",
    "macos",
    "windows",
    "*.podspec",
    "!macos/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "macos",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jihoobyeon/react-native-keyboard-shortcuts.git"
  },
  "author": "Jihoo Byeon <jihoobyeon@gmail.com> (https://github.com/jihoobyeon)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jihoobyeon/react-native-keyboard-shortcuts/issues"
  },
  "homepage": "https://github.com/jihoobyeon/react-native-keyboard-shortcuts#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.2",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "react": "19.2.3",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "react-native-windows": "0.81.40",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-macos": "*",
    "react-native-windows": "*"
  },
  "codegenConfig": {
    "name": "KeyboardShortcutsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "windows": {
      "namespace": "KeyboardShortcutsCodegen",
      "outputDirectory": "windows/KeyboardShortcuts/codegen",
      "separateDataTypes": true
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "version": "0.63.1"
  }
}
